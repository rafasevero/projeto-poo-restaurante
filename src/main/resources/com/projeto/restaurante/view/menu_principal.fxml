<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.projeto.restaurante.controller.MenuController"
            prefWidth="600.0" prefHeight="400.0"
            style="-fx-background-color: #f4f6f7;">

    <top>
        <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-background-color: #2c3e50; -fx-padding: 10px 20px;">
            <children>
                <Label fx:id="lblUsuarioLogado" text="Logado como: Funcionário"
                       style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;"
                       HBox.hgrow="ALWAYS"/>
                <Button text="Sair / Logout" onAction="#sairOnAction"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </children>
        </HBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="20.0">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
            </padding>
            <children>
                <Label text="Painel Principal" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

                <HBox alignment="CENTER" spacing="15.0">
                    <children>
                        <Button text="Comandas" onAction="#abrirComandas"
                                prefWidth="160.0" prefHeight="80.0"
                                style="-fx-font-size: 13px; -fx-font-weight: bold;"/>

                        <Button text="Produtos" onAction="#abrirProdutos"
                                prefWidth="160.0" prefHeight="80.0"
                                style="-fx-font-size: 13px; -fx-font-weight: bold;"/>

                        <Button text="Gerenciar Cardápio"
                                onAction="#abrirCardapioOnAction"
                                prefWidth="200.0" prefHeight="40.0"
                                style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold;"/>

                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>