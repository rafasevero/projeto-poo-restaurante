<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.projeto.restaurante.controller.CardapioController"
            prefWidth="620.0" prefHeight="620.0"
            style="-fx-background-color: #f4f6f7;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #2c3e50; -fx-padding: 12px;">
            <children>
                <Button text="← Voltar" onAction="#voltarOnAction" style="-fx-font-weight: bold;"/>
                <Label text="Gerenciamento do Cardápio" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;"/>
            </children>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #f4f6f7;">
            <content>
                <VBox spacing="12.0" alignment="TOP_LEFT" maxWidth="520.0">
                    <padding>
                        <Insets top="20.0" right="25.0" bottom="25.0" left="25.0"/>
                    </padding>
                    <children>
                        <Label text="Itens do Cardápio (clique para selecionar):" style="-fx-font-weight: bold;"/>
                        <ListView fx:id="listCardapio" prefHeight="160.0"/>

                        <Label text="Nome da Seção (ex: Bebidas, Porções):" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="txtNomeSecao" promptText="Ex: Bebidas"/>

                        <Label text="Produto Associado:" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="cbProdutos" promptText="Selecione um produto..." maxWidth="Infinity"/>

                        <Label text="Descrição Detalhada:" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="txtDescricao" promptText="Ex: Serve 2 pessoas, super gelado..."/>

                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <padding>
                                <Insets top="10.0"/>
                            </padding>
                            <children>
                                <Button text="Cadastrar" onAction="#salvarOnAction"
                                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" prefWidth="100.0" prefHeight="35.0"/>

                                <Button text="Atualizar" onAction="#atualizarOnAction"
                                        style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold;" prefWidth="100.0" prefHeight="35.0"/>

                                <Button text="Excluir" onAction="#deletarOnAction"
                                        style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold;" prefWidth="90.0" prefHeight="35.0"/>

                                <Button text="Limpar" onAction="#limparOnAction"
                                        prefWidth="80.0" prefHeight="35.0"/>
                            </children>
                        </HBox>

                        <Label fx:id="lblMensagem" text="" wrapText="true"/>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>