<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.projeto.restaurante.controller.ProdutoController"
            prefWidth="620.0" prefHeight="600.0"
            style="-fx-background-color: #f4f6f7;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #2c3e50; -fx-padding: 12px;">
            <children>
                <Button text="← Voltar" onAction="#voltarOnAction" style="-fx-font-weight: bold;"/>
                <Label text="Gerenciamento de Produtos" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;"/>
            </children>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #f4f6f7;">
            <content>
                <VBox spacing="12.0" alignment="TOP_LEFT" maxWidth="520.0">
                    <padding>
                        <Insets top="20.0" right="25.0" bottom="25.0" left="25.0"/>
                    </padding>
                    <children>
                        <Label text="Produtos Cadastrados (clique para selecionar):" style="-fx-font-weight: bold;"/>
                        <ListView fx:id="listProdutos" prefHeight="180.0"/>

                        <Label text="Nome do Produto:" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="txtNome" promptText="Ex: Refrigerante Lata"/>

                        <Label text="Preço (R$):" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="txtPreco" promptText="Ex: 6.00"/>

                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <padding>
                                <Insets top="10.0"/>
                            </padding>
                            <children>
                                <Button text="Cadastrar" onAction="#salvarOnAction"
                                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" prefWidth="100.0" prefHeight="35.0"/>

                                <Button text="Atualizar" onAction="#atualizarOnAction"
                                        style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold;" prefWidth="100.0" prefHeight="35.0"/>

                                <Button text="Excluir" onAction="#deletarOnAction"
                                        style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold;" prefWidth="90.0" prefHeight="35.0"/>

                                <Button text="Limpar" onAction="#limparOnAction"
                                        prefWidth="80.0" prefHeight="35.0"/>
                            </children>
                        </HBox>

                        <Label fx:id="lblMensagem" text="" wrapText="true"/>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>