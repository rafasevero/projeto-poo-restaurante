<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.projeto.restaurante.controller.ComandaController"
            prefWidth="600.0" prefHeight="550.0"
            style="-fx-background-color: #f4f6f7;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #2c3e50; -fx-padding: 12px;">
            <children>
                <Button text="← Voltar" onAction="#voltarOnAction" style="-fx-font-weight: bold;"/>
                <Label text="Gerenciamento de Comandas" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;"/>
            </children>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #f4f6f7;">
            <content>
                <VBox spacing="15.0" alignment="TOP_LEFT" maxWidth="480.0">
                    <padding>
                        <Insets top="20.0" right="25.0" bottom="25.0" left="25.0"/>
                    </padding>
                    <children>
                        <Label text="Número da Mesa:" style="-fx-font-weight: bold;"/>
                        <HBox spacing="10.0">
                            <children>
                                <TextField fx:id="txtMesa" promptText="Ex: 4" HBox.hgrow="ALWAYS"/>
                                <Button text="Buscar por Mesa" onAction="#buscarOnAction" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;"/>
                            </children>
                        </HBox>

                        <Label text="Status da Comanda (ABERTA / FECHADA / PAGA):" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="txtStatus" promptText="Ex: ABERTA"/>

                        <Label text="Valor Total (R$):" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="txtValorTotal" promptText="Ex: 0.00"/>

                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <padding>
                                <Insets top="10.0"/>
                            </padding>
                            <children>
                                <Button text="Criar Comanda" onAction="#criarOnAction"
                                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" prefWidth="130.0" prefHeight="35.0"/>

                                <Button text="Atualizar" onAction="#atualizarOnAction"
                                        style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold;" prefWidth="120.0" prefHeight="35.0"/>

                                <Button text="Limpar" onAction="#limparOnAction"
                                        prefWidth="90.0" prefHeight="35.0"/>
                            </children>
                        </HBox>

                        <Label fx:id="lblMensagem" text="" wrapText="true"/>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>